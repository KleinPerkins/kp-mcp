[project]
name = "__KIT_NAME__"
version = "0.1.0"
description = "Standalone single-core/dual-surface __DOMAIN_TITLE__ toolkit (CLI + MCP)."
requires-python = ">=3.11"
dependencies = [
    "pydantic>=2",
    # Versioned sibling pin (R13): recorded in the built wheel as
    # Requires-Dist: kp-mcp-bootstrap==0.4.0. Dev resolves locally via the
    # [tool.uv.sources] workspace override below.
    "kp-mcp-bootstrap==0.4.0",
    "mcp>=1.27.2",
    # Add your domain's API client libraries here.
]

[project.scripts]
__KIT_NAME__ = "__PKG__.cli:main"

[project.optional-dependencies]
dev = [
    "pytest>=7",
    "kp-mcp-testkit==0.1.0",
]

[tool.uv.sources]
kp-mcp-bootstrap = { workspace = true }
kp-mcp-testkit = { workspace = true }

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/__PKG__"]
