"""__KIT_NAME__ CLI — generic dispatcher over the registry (single-core/dual-surface).

Usage:
  __KIT_NAME__ <svc> <op> [--field value ...]   run an op, print a JSON envelope
  __KIT_NAME__ --list                           list every registered op
  __KIT_NAME__ mcp                              start the MCP stdio server
  __KIT_NAME__ bootstrap                        report registration authority requirements
  __KIT_NAME__ auth <login|status|logout>       manage credentials (Keychain)

Adding an op to the registry makes it available here automatically — no CLI edits.
"""
from __future__ import annotations

import sys
from typing import Any

import __PKG__  # noqa: F401 — triggers service auto-registration
from __PKG__.core.normalize import stable_json
from __PKG__.registry import all_specs, get


def _coerce(value: str) -> Any:
    low = value.lower()
    if low in ("true", "false"):
        return low == "true"
    try:
        return int(value)
    except ValueError:
        pass
    try:
        return float(value)
    except ValueError:
        return value


def _parse_fields(args: list[str]) -> dict[str, Any]:
    """Parse ``--key value`` / ``--flag`` tokens into a dict for model validation."""
    fields: dict[str, Any] = {}
    i = 0
    while i < len(args):
        tok = args[i]
        if tok.startswith("--"):
            key = tok[2:].replace("-", "_")
            if i + 1 < len(args) and not args[i + 1].startswith("--"):
                fields[key] = _coerce(args[i + 1])
                i += 2
            else:
                fields[key] = True
                i += 1
        else:
            i += 1
    return fields


def _list_ops() -> int:
    for spec in sorted(all_specs(), key=lambda s: s.name):
        print(f"{spec.name:30} {spec.posture}")
    return 0


def main(argv: list[str] | None = None) -> int:
    """CLI entry point."""
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "--list":
        return _list_ops()
    if argv[0] == "mcp":
        from __PKG__.mcp import main as mcp_main

        mcp_main()
        return 0
    if argv[0] == "bootstrap":
        from __PKG__.bootstrap import bootstrap

        from kp_mcp_bootstrap.registrars import Outcome, RegistrarError, Result

        try:
            result = bootstrap(dry_run="--dry-run" in argv[1:])
        except RegistrarError as exc:
            print(stable_json({"status": "refused", "reason_codes": [code.value for code in exc.reason_codes],
                               "next_action": "Live registration is blocked until native writer exclusion is qualified; use the separate owner workflow."}), file=sys.stderr)
            return 1
        failed = any(isinstance(value, Result) and value.outcome not in {Outcome.APPLIED, Outcome.NO_CHANGE}
                     for value in result.values())
        print(stable_json({key: value.to_dict() if isinstance(value, Result) else value
                           for key, value in result.items()}))
        return int(failed)
    if argv[0] == "auth":
        from __PKG__.cli.auth import run_auth

        return run_auth(argv[1:])

    if len(argv) < 2:
        print("error: expected '<svc> <op>' (try --list)", file=sys.stderr)
        return 2
    op_name = f"{argv[0]}.{argv[1]}"
    try:
        spec = get(op_name)
    except KeyError:
        print(f"error: unknown op {op_name!r} (try --list)", file=sys.stderr)
        return 2

    inp = spec.input_model.model_validate(_parse_fields(argv[2:]))
    try:
        result = spec.fn(inp)
    except Exception as exc:  # noqa: BLE001 — surface as a JSON error envelope
        print(stable_json({"status": "error", "op": op_name, "error": str(exc)}), file=sys.stderr)
        return 1
    print(stable_json(result.model_dump()))
    return 0
