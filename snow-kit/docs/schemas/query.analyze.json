{
  "description": "Analyze a read-only query with EXPLAIN plus simple performance heuristics. Use this for: analyze this sql; explain sql; explain; performance; sql. For analytical SQL, consult approved analytics context when available and inspect relevant catalog metadata first; do not guess schema.",
  "inputSchema": {
    "$defs": {
      "ContextReference": {
        "description": "Opaque approved-context reference returned by context.search.",
        "properties": {
          "document_id": {
            "pattern": "^[a-f0-9]{24}$",
            "title": "Document Id",
            "type": "string"
          },
          "revision": {
            "pattern": "^[a-f0-9]{40,64}$",
            "title": "Revision",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "revision"
        ],
        "title": "ContextReference",
        "type": "object"
      }
    },
    "properties": {
      "context_refs": {
        "description": "Validated document_id/revision pairs returned by context.search.",
        "items": {
          "$ref": "#/$defs/ContextReference"
        },
        "maxItems": 10,
        "title": "Context Refs",
        "type": "array"
      },
      "query": {
        "description": "Read-only SQL query to EXPLAIN and analyze.",
        "title": "Query",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "title": "QueryAnalyzeInput",
    "type": "object"
  },
  "name": "query_analyze",
  "outputSchema": {
    "$defs": {
      "Meta": {
        "description": "Per-operation metadata returned in the envelope.",
        "properties": {
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          }
        },
        "title": "Meta",
        "type": "object"
      },
      "QueryAnalyzeData": {
        "properties": {
          "execution_plan": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Execution Plan",
            "type": "array"
          },
          "execution_time_ms": {
            "title": "Execution Time Ms",
            "type": "number"
          },
          "performance_issues": {
            "items": {
              "type": "string"
            },
            "title": "Performance Issues",
            "type": "array"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "title": "Recommendations",
            "type": "array"
          }
        },
        "required": [
          "execution_plan",
          "performance_issues",
          "recommendations",
          "execution_time_ms"
        ],
        "title": "QueryAnalyzeData",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/QueryAnalyzeData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "data"
    ],
    "title": "OutputEnvelope[QueryAnalyzeData]",
    "type": "object"
  }
}
