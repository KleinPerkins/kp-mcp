{
  "description": "Execute a read-only Snowflake query and return normalized JSON rows. Use this for: execute snowflake query; run this read-only query; read-only; snowflake; sql; query. For analytical SQL, consult approved analytics context when available and inspect relevant catalog metadata first; do not guess schema. max_rows caps rows returned to the client only; it does not add SQL LIMIT or reduce warehouse scanning. USE statements change session context.",
  "inputSchema": {
    "$defs": {
      "ContextReference": {
        "description": "Opaque approved-context reference returned by context.search.",
        "properties": {
          "document_id": {
            "pattern": "^[a-f0-9]{24}$",
            "title": "Document Id",
            "type": "string"
          },
          "revision": {
            "pattern": "^[a-f0-9]{40,64}$",
            "title": "Revision",
            "type": "string"
          }
        },
        "required": [
          "document_id",
          "revision"
        ],
        "title": "ContextReference",
        "type": "object"
      }
    },
    "properties": {
      "context_refs": {
        "description": "Validated document_id/revision pairs returned by context.search.",
        "items": {
          "$ref": "#/$defs/ContextReference"
        },
        "maxItems": 10,
        "title": "Context Refs",
        "type": "array"
      },
      "max_rows": {
        "anyOf": [
          {
            "maximum": 10000,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional row cap.",
        "title": "Max Rows"
      },
      "query": {
        "description": "Read-only SQL query: SELECT, SHOW, DESCRIBE, EXPLAIN, USE, or WITH.",
        "title": "Query",
        "type": "string"
      }
    },
    "required": [
      "query"
    ],
    "title": "QueryExecuteInput",
    "type": "object"
  },
  "name": "query_execute",
  "outputSchema": {
    "$defs": {
      "Meta": {
        "description": "Per-operation metadata returned in the envelope.",
        "properties": {
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          }
        },
        "title": "Meta",
        "type": "object"
      },
      "QueryExecuteData": {
        "properties": {
          "execution_time_ms": {
            "title": "Execution Time Ms",
            "type": "number"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          },
          "statement_type": {
            "title": "Statement Type",
            "type": "string"
          },
          "truncated": {
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "rows",
          "row_count",
          "truncated",
          "statement_type",
          "execution_time_ms"
        ],
        "title": "QueryExecuteData",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/QueryExecuteData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "data"
    ],
    "title": "OutputEnvelope[QueryExecuteData]",
    "type": "object"
  }
}
