          },
          "execution_time_ms": {
            "title": "Execution Time Ms",
            "type": "number"
          },
          "rows": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Rows",
            "type": "array"
          },
          "truncated": {
            "default": false,
            "title": "Truncated",
            "type": "boolean"
          }
        },
        "required": [
          "rows",
          "count",
          "execution_time_ms"
