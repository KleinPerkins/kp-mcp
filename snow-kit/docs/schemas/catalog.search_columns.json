{
  "description": "Search bounded SHOW COLUMNS metadata and flag its 10,000-row cap. Use this for: find a column; search scoped column metadata; catalog; column; columns; search.",
  "inputSchema": {
    "properties": {
      "column_name": {
        "title": "Column Name",
        "type": "string"
      },
      "database": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Database"
      },
      "limit": {
        "default": 1000,
        "maximum": 10000,
        "minimum": 1,
        "title": "Limit",
        "type": "integer"
      },
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Schema"
      }
    },
    "required": [
      "column_name"
    ],
    "title": "CatalogSearchColumnsInput",
    "type": "object"
  },
  "name": "catalog_search_columns",
  "outputSchema": {
    "$defs": {
