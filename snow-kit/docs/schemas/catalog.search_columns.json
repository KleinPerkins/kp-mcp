        "properties": {
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          }
        },
        "title": "Meta",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/CatalogRowsData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "data"
    ],
    "title": "OutputEnvelope[CatalogRowsData]",
    "type": "object"
  }
