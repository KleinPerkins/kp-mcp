{
  "description": "List Drive changes or get the start page token for change tracking.",
  "inputSchema": {
    "description": "Input for ``drive.changes``: list Drive changes or get the start page token.",
    "properties": {
      "page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Page Token"
      }
    },
    "title": "DriveChangesInput",
    "type": "object"
  },
  "name": "drive_changes",
  "outputSchema": {
    "$defs": {
      "DriveChangesData": {
        "description": "Data payload for ``drive.changes``.\n\n``new_start_page_token`` is the baseline cursor to resume change tracking in\na future session and stays in ``data`` as a domain cursor. Page-level\ncontinuation is surfaced via the envelope ``page.next_page_token``.",
        "properties": {
          "changes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Changes",
            "type": "array"
          },
          "new_start_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "New Start Page Token"
          }
        },
        "required": [
          "changes"
        ],
        "title": "DriveChangesData",
        "type": "object"
      },
      "Meta": {
        "description": "Operation metadata returned in the output envelope.\n\nCarries the architecture-brief \u00a78 observability envelope. The base fields\n(``run_id``, ``op``, ``latency_ms``) are populated by every op; the\nrouting/composition fields (``api``..``saga_compensated``) are populated by\ncapabilities that go through the router (thick reads) or a recipe (saga).\nLegacy 1:1 ops leave the extended fields at their defaults \u2014 they are all\noptional and strictly additive (no existing op needs to change).",
        "properties": {
          "api": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Api"
          },
          "calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calls"
          },
          "fallback_used": {
            "default": false,
            "title": "Fallback Used",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "quota_units_est": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quota Units Est"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recipe Id"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "saga_compensated": {
            "default": false,
            "title": "Saga Compensated",
            "type": "boolean"
          },
          "scopes_used": {
            "items": {
              "type": "string"
            },
            "title": "Scopes Used",
            "type": "array"
          }
        },
        "title": "Meta",
        "type": "object"
      },
      "PageInfo": {
        "description": "Pagination metadata returned in the output envelope.",
        "properties": {
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Page Token"
          },
          "total_items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Items"
          }
        },
        "title": "PageInfo",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/DriveChangesData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "page": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageInfo"
