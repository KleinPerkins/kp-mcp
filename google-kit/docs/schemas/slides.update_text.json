{
  "description": "Replace or insert text in a presentation.",
  "inputSchema": {
    "description": "Input for ``slides.update_text``: replace or insert text in a presentation.\n\nTwo modes (mutually exclusive):\n  - Global replace: provide ``find`` + ``replace`` (case-sensitive replaceAllText).\n  - Direct insert: provide ``object_id`` + ``text`` (deleteText + insertText on a shape).",
    "properties": {
      "find": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Text to find for global case-sensitive replacement",
        "title": "Find"
      },
      "object_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Shape object ID for direct text update",
        "title": "Object Id"
      },
      "presentation_id": {
        "title": "Presentation Id",
        "type": "string"
      },
      "replace": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Replacement text (used with find)",
        "title": "Replace"
      },
      "text": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "New text content (used with object_id)",
        "title": "Text"
      }
    },
    "required": [
      "presentation_id"
    ],
    "title": "SlidesUpdateTextInput",
    "type": "object"
  },
  "name": "slides_update_text",
