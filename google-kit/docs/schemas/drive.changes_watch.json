{
  "description": "Register a Drive push-notification channel (web_hook) via changes.watch.",
  "inputSchema": {
    "description": "Input for ``drive.changes_watch``: register an HTTPS push-notification channel.\n\nDrive delivers change events to ``address`` (must be HTTPS). The channel\nis identified by ``channel_id`` and scoped to changes starting at\n``page_token``. ``expiration_ms`` is an optional Unix-epoch millisecond\ntimestamp; omit to let Drive choose the channel lifetime.\n\nNote: the HTTPS endpoint and channel identity must be provisioned by the\noperator before calling this op.",
    "properties": {
      "address": {
        "description": "HTTPS webhook URL that Drive will push to.",
        "title": "Address",
        "type": "string"
      },
      "channel_id": {
        "description": "Unique channel ID assigned by the operator.",
        "title": "Channel Id",
        "type": "string"
      },
      "expiration_ms": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional channel expiration as Unix-epoch milliseconds.",
        "title": "Expiration Ms"
      },
      "page_token": {
        "description": "Start page token for the change feed.",
        "title": "Page Token",
        "type": "string"
      }
    },
    "required": [
      "page_token",
      "channel_id",
      "address"
    ],
    "title": "DriveChangesWatchInput",
    "type": "object"
  },
  "name": "drive_changes_watch",
  "outputSchema": {
    "$defs": {
      "DriveChangesWatchData": {
        "description": "Data payload for ``drive.changes_watch`` (the registered channel resource).",
        "properties": {
          "expiration": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Expiration"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "resourceId": {
            "title": "Resourceid",
            "type": "string"
          },
          "resourceUri": {
            "title": "Resourceuri",
            "type": "string"
          }
        },
        "required": [
          "id",
          "resourceId",
          "resourceUri"
        ],
        "title": "DriveChangesWatchData",
        "type": "object"
      },
      "Meta": {
        "description": "Operation metadata returned in the output envelope.\n\nCarries the architecture-brief \u00a78 observability envelope. The base fields\n(``run_id``, ``op``, ``latency_ms``) are populated by every op; the\nrouting/composition fields (``api``..``saga_compensated``) are populated by\ncapabilities that go through the router (thick reads) or a recipe (saga).\nLegacy 1:1 ops leave the extended fields at their defaults \u2014 they are all\noptional and strictly additive (no existing op needs to change).",
        "properties": {
          "api": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Api"
          },
          "calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calls"
          },
          "fallback_used": {
            "default": false,
            "title": "Fallback Used",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "quota_units_est": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quota Units Est"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recipe Id"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "saga_compensated": {
            "default": false,
            "title": "Saga Compensated",
            "type": "boolean"
          },
          "scopes_used": {
            "items": {
              "type": "string"
            },
            "title": "Scopes Used",
            "type": "array"
