{
  "description": "Create, list, delete, or renew watches for a form.",
  "inputSchema": {
    "description": "Input for ``forms.watches``: create, list, delete, or renew form watches.\n\n``action=create`` requires an operator-provisioned Cloud Pub/Sub topic.\n``action=delete`` and ``action=renew`` require ``watch_id``.",
    "properties": {
      "action": {
        "default": "create",
        "description": "Watch operation to perform: create, list, delete, or renew",
        "enum": [
          "create",
          "list",
          "delete",
          "renew"
        ],
        "title": "Action",
        "type": "string"
      },
      "event_type": {
        "default": "RESPONSES",
        "description": "Watch event type: EVENT_TYPE_UNSPECIFIED | SCHEMA | RESPONSES",
        "enum": [
          "EVENT_TYPE_UNSPECIFIED",
          "SCHEMA",
          "RESPONSES"
        ],
        "title": "Event Type",
        "type": "string"
      },
      "form_id": {
        "description": "Google Forms form ID that owns the watch",
        "title": "Form Id",
        "type": "string"
      },
      "topic_name": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Fully-qualified Cloud Pub/Sub topic name, e.g. projects/<project>/topics/<topic>",
        "title": "Topic Name"
      },
      "watch_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Watch ID required for delete and renew actions",
        "title": "Watch Id"
      }
    },
    "required": [
      "form_id"
    ],
    "title": "FormsWatchesInput",
    "type": "object"
  },
  "name": "forms_watches",
