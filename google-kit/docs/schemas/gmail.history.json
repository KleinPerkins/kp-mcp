{
  "description": "List mailbox history events since a given history ID.",
  "inputSchema": {
    "description": "Input for ``gmail.history``: list mailbox history since a given history ID.",
    "properties": {
      "history_types": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Event types to include: messageAdded, messageDeleted, labelAdded, labelRemoved",
        "title": "History Types"
      },
      "label_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Filter history by label ID",
        "title": "Label Id"
      },
      "max_results": {
        "default": 100,
        "maximum": 500,
        "minimum": 1,
        "title": "Max Results",
        "type": "integer"
      },
      "page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Page token for continuation",
        "title": "Page Token"
      },
      "start_history_id": {
        "description": "History ID to start listing from (exclusive)",
        "title": "Start History Id",
        "type": "string"
      }
    },
    "required": [
      "start_history_id"
    ],
    "title": "GmailHistoryInput",
    "type": "object"
  },
  "name": "gmail_history",
  "outputSchema": {
    "$defs": {
      "GmailHistoryData": {
        "description": "Data payload for ``gmail.history``.\n\n``history_id`` is the mailbox watermark (the next ``start_history_id`` for a\nsubsequent sync) and stays in ``data`` as a domain cursor. Page-level\ncontinuation is surfaced via the envelope ``page.next_page_token``.",
        "properties": {
          "history": {
            "items": {
              "$ref": "#/$defs/GmailHistoryRecord"
            },
            "title": "History",
            "type": "array"
          },
          "history_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "History Id"
          }
        },
        "required": [
          "history"
        ],
        "title": "GmailHistoryData",
        "type": "object"
      },
      "GmailHistoryMessageRef": {
        "description": "Minimal message reference inside a history record.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "thread_id"
        ],
        "title": "GmailHistoryMessageRef",
        "type": "object"
      },
      "GmailHistoryRecord": {
        "description": "One history record entry.",
        "properties": {
          "extra": {
            "additionalProperties": true,
            "title": "Extra",
            "type": "object"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "messages": {
            "items": {
              "$ref": "#/$defs/GmailHistoryMessageRef"
            },
            "title": "Messages",
            "type": "array"
          }
        },
        "required": [
          "id"
        ],
        "title": "GmailHistoryRecord",
        "type": "object"
      },
      "Meta": {
        "description": "Operation metadata returned in the output envelope.\n\nCarries the architecture-brief \u00a78 observability envelope. The base fields\n(``run_id``, ``op``, ``latency_ms``) are populated by every op; the\nrouting/composition fields (``api``..``saga_compensated``) are populated by\ncapabilities that go through the router (thick reads) or a recipe (saga).\nLegacy 1:1 ops leave the extended fields at their defaults \u2014 they are all\noptional and strictly additive (no existing op needs to change).",
        "properties": {
          "api": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Api"
          },
          "calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calls"
          },
          "fallback_used": {
            "default": false,
            "title": "Fallback Used",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "quota_units_est": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quota Units Est"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recipe Id"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "saga_compensated": {
            "default": false,
            "title": "Saga Compensated",
            "type": "boolean"
          },
          "scopes_used": {
            "items": {
              "type": "string"
            },
            "title": "Scopes Used",
            "type": "array"
          }
        },
        "title": "Meta",
        "type": "object"
      },
      "PageInfo": {
        "description": "Pagination metadata returned in the output envelope.",
        "properties": {
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Page Token"
          },
          "total_items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Items"
          }
        },
        "title": "PageInfo",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/GmailHistoryData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "page": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageInfo"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "data"
    ],
    "title": "OutputEnvelope[GmailHistoryData]",
    "type": "object"
  }
}
