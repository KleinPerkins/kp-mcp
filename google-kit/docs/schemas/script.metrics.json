        },
        "required": [
          "active_users",
          "total_executions",
          "failed_executions"
        ],
        "title": "ScriptMetricsData",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/ScriptMetricsData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "page": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageInfo"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "data"
    ],
    "title": "OutputEnvelope[ScriptMetricsData]",
    "type": "object"
  }
}
