      "Meta": {
        "description": "Operation metadata returned in the output envelope.\n\nCarries the architecture-brief \u00a78 observability envelope. The base fields\n(``run_id``, ``op``, ``latency_ms``) are populated by every op; the\nrouting/composition fields (``api``..``saga_compensated``) are populated by\ncapabilities that go through the router (thick reads) or a recipe (saga).\nLegacy 1:1 ops leave the extended fields at their defaults \u2014 they are all\noptional and strictly additive (no existing op needs to change).",
        "properties": {
          "api": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Api"
          },
          "calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calls"
          },
          "fallback_used": {
            "default": false,
            "title": "Fallback Used",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "quota_units_est": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quota Units Est"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recipe Id"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "saga_compensated": {
            "default": false,
            "title": "Saga Compensated",
            "type": "boolean"
          },
          "scopes_used": {
            "items": {
              "type": "string"
            },
            "title": "Scopes Used",
            "type": "array"
          }
        },
        "title": "Meta",
        "type": "object"
      },
      "PageInfo": {
        "description": "Pagination metadata returned in the output envelope.",
        "properties": {
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Page Token"
          },
          "total_items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Items"
          }
        },
        "title": "PageInfo",
        "type": "object"
      },
      "ScriptMetricsData": {
        "description": "Data payload for ``script.metrics``.",
        "properties": {
          "active_users": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Active Users",
            "type": "array"
          },
          "failed_executions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Failed Executions",
            "type": "array"
          },
          "total_executions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
