{
  "description": "Retrieve execution metrics for a script project.",
  "inputSchema": {
    "description": "Input for ``script.metrics``: retrieve execution metrics for a script.",
    "properties": {
      "metrics_filter_deployment_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Limit metrics to a specific deployment ID. Optional.",
        "title": "Metrics Filter Deployment Id"
      },
      "metrics_granularity": {
        "description": "Granularity of returned metrics: WEEKLY or DAILY.",
        "title": "Metrics Granularity",
        "type": "string"
      },
      "script_id": {
        "title": "Script Id",
        "type": "string"
      }
    },
    "required": [
      "script_id",
      "metrics_granularity"
    ],
    "title": "ScriptMetricsInput",
    "type": "object"
  },
  "name": "script_metrics",
  "outputSchema": {
