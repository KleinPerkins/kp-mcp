        "description": "Fully-qualified Pub/Sub topic name, e.g. 'projects/<project>/topics/<topic>'.",
        "title": "Pubsub Topic",
        "type": "string"
      },
      "target_resource": {
        "description": "Full resource name of the Drive target, e.g. a file '//drive.googleapis.com/files/<id>' or shared drive '//drive.googleapis.com/drives/<id>'.",
