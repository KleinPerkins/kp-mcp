{
  "description": "Read a Doc to hydrate context, then apply refinement requests (saga-guarded).",
  "inputSchema": {
    "description": "Input for ``recipes.hydrate_then_refine``: read a Doc, then apply refinements.",
    "properties": {
      "document_id": {
        "description": "Drive/Docs file ID or URL to hydrate then refine.",
        "title": "Document Id",
        "type": "string"
      },
      "hydrate_metadata_only": {
        "default": true,
        "description": "Hydrate via a metadata-only fetch (no full content export).",
        "title": "Hydrate Metadata Only",
        "type": "boolean"
      },
      "requests": {
        "description": "Docs API batchUpdate request objects to apply as the refinement.",
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Requests",
        "type": "array"
      },
      "style_overrides": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Inline style profile overrides.",
        "title": "Style Overrides"
      },
      "style_profile": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Optional local Docs style profile to append to the refinement.",
        "title": "Style Profile"
      }
    },
    "required": [
      "document_id",
      "requests"
    ],
    "title": "HydrateThenRefineInput",
    "type": "object"
  },
  "name": "recipes_hydrate_then_refine",
  "outputSchema": {
    "$defs": {
      "HydrateThenRefineData": {
        "description": "Data payload for ``recipes.hydrate_then_refine``.",
        "properties": {
          "doc_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Doc Id"
          },
          "mime_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Mime Type"
          },
          "refine_replies": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Refine Replies",
            "type": "array"
          },
          "requests_applied": {
            "default": 0,
            "title": "Requests Applied",
            "type": "integer"
          },
          "status": {
            "enum": [
              "completed",
              "rolled_back"
            ],
            "title": "Status",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Title"
          }
        },
        "required": [
          "status"
        ],
        "title": "HydrateThenRefineData",
        "type": "object"
      },
      "Meta": {
        "description": "Operation metadata returned in the output envelope.\n\nCarries the architecture-brief \u00a78 observability envelope. The base fields\n(``run_id``, ``op``, ``latency_ms``) are populated by every op; the\nrouting/composition fields (``api``..``saga_compensated``) are populated by\ncapabilities that go through the router (thick reads) or a recipe (saga).\nLegacy 1:1 ops leave the extended fields at their defaults \u2014 they are all\noptional and strictly additive (no existing op needs to change).",
        "properties": {
          "api": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Api"
          },
          "calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calls"
          },
          "fallback_used": {
            "default": false,
            "title": "Fallback Used",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "quota_units_est": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quota Units Est"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recipe Id"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "saga_compensated": {
            "default": false,
            "title": "Saga Compensated",
            "type": "boolean"
          },
          "scopes_used": {
            "items": {
              "type": "string"
            },
            "title": "Scopes Used",
            "type": "array"
          }
        },
        "title": "Meta",
        "type": "object"
      },
      "PageInfo": {
        "description": "Pagination metadata returned in the output envelope.",
        "properties": {
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Page Token"
          },
          "total_items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Items"
          }
        },
        "title": "PageInfo",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/HydrateThenRefineData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "page": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageInfo"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "data"
    ],
    "title": "OutputEnvelope[HydrateThenRefineData]",
    "type": "object"
  }
}
