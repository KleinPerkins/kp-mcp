{
  "description": "List responses for a form.",
  "inputSchema": {
    "description": "Input for ``forms.list_responses``: list responses to a form (paginated).",
    "properties": {
      "form_id": {
        "title": "Form Id",
        "type": "string"
      },
      "page_size": {
        "anyOf": [
          {
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Max responses per page",
        "title": "Page Size"
      },
      "page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Continuation token from a prior call",
        "title": "Page Token"
      }
    },
    "required": [
      "form_id"
    ],
    "title": "FormsListResponsesInput",
    "type": "object"
  },
  "name": "forms_list_responses",
  "outputSchema": {
    "$defs": {
      "FormsAnswer": {
        "description": "One answer within a form response.",
        "properties": {
          "question_id": {
            "title": "Question Id",
            "type": "string"
          },
          "text_values": {
            "items": {
              "type": "string"
            },
            "title": "Text Values",
            "type": "array"
          }
        },
        "required": [
          "question_id",
          "text_values"
        ],
        "title": "FormsAnswer",
        "type": "object"
      },
      "FormsListResponsesData": {
        "description": "Data payload for ``forms.list_responses``.",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "responses": {
            "items": {
              "$ref": "#/$defs/FormsResponseRecord"
            },
            "title": "Responses",
            "type": "array"
          }
        },
        "required": [
          "count",
          "responses"
        ],
        "title": "FormsListResponsesData",
        "type": "object"
      },
      "FormsResponseRecord": {
        "description": "One submitted form response.",
        "properties": {
          "answer_count": {
            "title": "Answer Count",
            "type": "integer"
          },
          "answers": {
            "items": {
              "$ref": "#/$defs/FormsAnswer"
            },
            "title": "Answers",
            "type": "array"
          },
          "create_time": {
            "title": "Create Time",
            "type": "string"
          },
          "response_id": {
            "title": "Response Id",
            "type": "string"
          }
        },
        "required": [
          "response_id",
          "create_time",
          "answer_count",
          "answers"
        ],
        "title": "FormsResponseRecord",
        "type": "object"
      },
      "Meta": {
        "description": "Operation metadata returned in the output envelope.\n\nCarries the architecture-brief \u00a78 observability envelope. The base fields\n(``run_id``, ``op``, ``latency_ms``) are populated by every op; the\nrouting/composition fields (``api``..``saga_compensated``) are populated by\ncapabilities that go through the router (thick reads) or a recipe (saga).\nLegacy 1:1 ops leave the extended fields at their defaults \u2014 they are all\noptional and strictly additive (no existing op needs to change).",
        "properties": {
          "api": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Api"
          },
          "calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calls"
          },
          "fallback_used": {
            "default": false,
            "title": "Fallback Used",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "quota_units_est": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quota Units Est"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recipe Id"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "saga_compensated": {
            "default": false,
            "title": "Saga Compensated",
            "type": "boolean"
          },
          "scopes_used": {
            "items": {
              "type": "string"
            },
            "title": "Scopes Used",
            "type": "array"
          }
        },
        "title": "Meta",
        "type": "object"
      },
      "PageInfo": {
        "description": "Pagination metadata returned in the output envelope.",
        "properties": {
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Page Token"
          },
          "total_items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Items"
          }
        },
        "title": "PageInfo",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/FormsListResponsesData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "page": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageInfo"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "data"
    ],
    "title": "OutputEnvelope[FormsListResponsesData]",
    "type": "object"
  }
}
