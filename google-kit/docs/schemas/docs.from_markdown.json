{
  "description": "Convert Markdown to a styled Google Doc using the legacy formatting contract.",
  "inputSchema": {
    "description": "Input for ``docs.from_markdown``: convert Markdown to a styled Google Doc.\n\n``markdown_content`` is the raw Markdown text.\n``title`` becomes the Google Doc title.\n``folder_id`` optionally places the doc in that Drive folder.",
    "properties": {
      "folder_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Folder Id"
      },
      "markdown_content": {
        "title": "Markdown Content",
        "type": "string"
      },
      "style_overrides": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Style Overrides"
      },
      "style_profile": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Style Profile"
      },
      "title": {
        "title": "Title",
        "type": "string"
      }
    },
    "required": [
      "markdown_content",
      "title"
    ],
    "title": "DocsFromMarkdownInput",
    "type": "object"
  },
  "name": "docs_from_markdown",
