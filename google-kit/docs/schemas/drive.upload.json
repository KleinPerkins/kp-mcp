            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Page Token"
          },
          "total_items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Items"
          }
        },
        "title": "PageInfo",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/DriveUploadData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "page": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageInfo"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
