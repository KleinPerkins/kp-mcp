        "type": "array"
      },
      "ids": {
        "description": "Message IDs to modify (must be non-empty)",
        "items": {
          "type": "string"
        },
        "title": "Ids",
        "type": "array"
      },
      "remove_label_ids": {
        "description": "Label IDs to remove from every message",
        "items": {
          "type": "string"
        },
        "title": "Remove Label Ids",
        "type": "array"
      }
    },
    "required": [
      "ids"
