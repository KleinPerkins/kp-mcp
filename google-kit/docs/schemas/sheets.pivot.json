{
  "description": "Create a pivot table via batchUpdate/updateCells with pivotTable field.",
  "inputSchema": {
    "$defs": {
      "SheetGridRange": {
        "description": "Grid range for chart data sources (start inclusive, end exclusive row/col indices).",
        "properties": {
          "end_col": {
            "title": "End Col",
            "type": "integer"
          },
          "end_row": {
            "title": "End Row",
            "type": "integer"
          },
          "start_col": {
            "title": "Start Col",
            "type": "integer"
          },
          "start_row": {
            "title": "Start Row",
            "type": "integer"
          }
        },
        "required": [
          "start_row",
          "end_row",
          "start_col",
          "end_col"
        ],
        "title": "SheetGridRange",
        "type": "object"
      },
      "SheetsPivotValueSpec": {
        "description": "One value summary for a pivot table.",
        "properties": {
          "source_column_offset": {
            "title": "Source Column Offset",
            "type": "integer"
          },
          "summarize_function": {
            "title": "Summarize Function",
            "type": "string"
          }
        },
        "required": [
          "source_column_offset",
          "summarize_function"
        ],
        "title": "SheetsPivotValueSpec",
        "type": "object"
      }
    },
    "description": "Input for ``sheets.pivot``: create a pivot table via batchUpdate/updateCells.",
    "properties": {
      "columns": {
        "items": {
          "type": "integer"
        },
        "title": "Columns",
        "type": "array"
      },
      "rows": {
        "items": {
          "type": "integer"
        },
        "title": "Rows",
        "type": "array"
      },
      "source_range": {
        "$ref": "#/$defs/SheetGridRange"
      },
      "source_sheet_id": {
        "title": "Source Sheet Id",
        "type": "integer"
      },
      "spreadsheet_id": {
        "title": "Spreadsheet Id",
        "type": "string"
      },
      "target_col": {
        "title": "Target Col",
        "type": "integer"
      },
      "target_row": {
        "title": "Target Row",
        "type": "integer"
      },
      "target_sheet_id": {
        "title": "Target Sheet Id",
        "type": "integer"
      },
      "values": {
        "items": {
          "$ref": "#/$defs/SheetsPivotValueSpec"
        },
        "title": "Values",
        "type": "array"
      }
    },
    "required": [
      "spreadsheet_id",
      "source_sheet_id",
      "source_range",
      "target_sheet_id",
      "target_row",
      "target_col"
    ],
    "title": "SheetsPivotInput",
    "type": "object"
  },
  "name": "sheets_pivot",
  "outputSchema": {
    "$defs": {
      "Meta": {
        "description": "Operation metadata returned in the output envelope.\n\nCarries the architecture-brief \u00a78 observability envelope. The base fields\n(``run_id``, ``op``, ``latency_ms``) are populated by every op; the\nrouting/composition fields (``api``..``saga_compensated``) are populated by\ncapabilities that go through the router (thick reads) or a recipe (saga).\nLegacy 1:1 ops leave the extended fields at their defaults \u2014 they are all\noptional and strictly additive (no existing op needs to change).",
        "properties": {
          "api": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Api"
          },
          "calls": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Calls"
          },
          "fallback_used": {
            "default": false,
            "title": "Fallback Used",
            "type": "boolean"
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latency Ms"
          },
          "method": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Method"
          },
          "op": {
            "default": "",
            "title": "Op",
            "type": "string"
          },
          "quota_units_est": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Quota Units Est"
          },
          "recipe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Recipe Id"
          },
          "run_id": {
            "default": "",
            "title": "Run Id",
            "type": "string"
          },
          "saga_compensated": {
            "default": false,
            "title": "Saga Compensated",
            "type": "boolean"
          },
          "scopes_used": {
            "items": {
              "type": "string"
            },
            "title": "Scopes Used",
            "type": "array"
          }
        },
        "title": "Meta",
        "type": "object"
      },
      "PageInfo": {
        "description": "Pagination metadata returned in the output envelope.",
        "properties": {
          "next_page_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Next Page Token"
          },
          "total_items": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Total Items"
          }
        },
        "title": "PageInfo",
        "type": "object"
      },
      "SheetsPivotData": {
        "description": "Data payload for ``sheets.pivot``.",
        "properties": {
          "replies_count": {
            "title": "Replies Count",
            "type": "integer"
          },
          "spreadsheet_id": {
            "title": "Spreadsheet Id",
            "type": "string"
          }
        },
        "required": [
          "spreadsheet_id",
          "replies_count"
        ],
        "title": "SheetsPivotData",
        "type": "object"
      }
    },
    "properties": {
      "data": {
        "$ref": "#/$defs/SheetsPivotData"
      },
      "meta": {
        "$ref": "#/$defs/Meta"
      },
      "page": {
        "anyOf": [
          {
            "$ref": "#/$defs/PageInfo"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "required": [
      "data"
    ],
    "title": "OutputEnvelope[SheetsPivotData]",
    "type": "object"
  }
}
