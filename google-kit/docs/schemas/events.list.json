{
  "description": "List Workspace Events subscriptions matching a filter.",
  "inputSchema": {
    "description": "Input for ``events.list``: list Workspace Events subscriptions.",
    "properties": {
      "filter": {
        "description": "Filter string, e.g. 'target_resource=\"//drive.googleapis.com/files/<file-id>\"'.",
        "title": "Filter",
        "type": "string"
      },
      "page_size": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Max subscriptions to return.",
        "title": "Page Size"
      },
      "page_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "description": "Continuation token.",
        "title": "Page Token"
      }
    },
    "required": [
      "filter"
    ],
    "title": "EventsListInput",
    "type": "object"
  },
