          "blue": {
            "default": 0.0,
            "title": "Blue",
            "type": "number"
          },
          "green": {
            "default": 0.0,
            "title": "Green",
            "type": "number"
          },
          "red": {
            "default": 0.0,
            "title": "Red",
            "type": "number"
          }
        },
